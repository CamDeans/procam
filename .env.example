# Server
PORT=5000
NODE_ENV=development

# Public URL (for OIDC callbacks and Stripe webhook base). No trailing slash.
BASE_URL=http://localhost:5000

# Database (MongoDB Atlas or any MongoDB)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/procam?retryWrites=true&w=majority
# Or local: mongodb://localhost:27017/procam

# Session (use a long random string)
SESSION_SECRET=your-session-secret-min-32-chars

# OIDC (Auth0, Keycloak, Google, or any OpenID Connect provider)
ISSUER_URL=https://your-issuer.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret

# Admin (only this email can change admin config; add partners in Admin Portal)
ADMIN_EMAIL=your-admin@procam.cloud

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
